# Apache-конфиг для поддомена booking.<клуб>.ru (раздача build/web).
# Кладётся в корень поддомена вместе с содержимым build/web.
# Для nginx аналог — в docs/DEPLOY.md.

# --- SPA-fallback: неизвестный путь -> index.html ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# --- Кэш ---
<IfModule mod_headers.c>
  # По умолчанию всё контентно-адресуемое (хэш в имени или в /assets) — надолго
  Header set Cache-Control "public, max-age=31536000, immutable"
  # ...кроме входных файлов — они должны обновляться сразу после релиза
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter_service_worker\.js|main\.dart\.js|version\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Сжатие ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

AddType application/wasm .wasm
