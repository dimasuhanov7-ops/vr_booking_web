# Всегда свежий вход в приложение — иначе браузер держит старый main.dart.js
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache

# CanvasKit версионирован по пути — можно кэшировать надолго
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

# Ассеты Flutter (шрифты, манифесты) хэша в имени не имеют: год кэша означал бы,
# что смена шрифта не доедет до пользователей. Держим сутки.
/assets/*
  Cache-Control: public, max-age=86400

# Виджет встраивается iframe'ом в ВК и на сайт клуба, поэтому X-Frame-Options
# ставить нельзя — вместо него frame-ancestors со списком разрешённых сайтов.
# Остальная CSP — в <meta> внутри index.html (работает независимо от хостинга).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Content-Security-Policy: frame-ancestors 'self' https://effectvr.ru https://*.effectvr.ru https://vrayarena.ru https://*.vrayarena.ru https://*.vk.com https://*.vk.ru https://*.vk-apps.com
