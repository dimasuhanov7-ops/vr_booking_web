# Всегда свежий вход в приложение — иначе браузер держит старый main.dart.js
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
/main.dart.js
  Cache-Control: no-cache
/version.json
  Cache-Control: no-cache

# Контентно-адресуемые ресурсы — можно кэшировать надолго
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/canvaskit/*
  Cache-Control: public, max-age=31536000, immutable

# Виджет встраивается iframe'ом в ВК и на сайт клуба
/*
  X-Content-Type-Options: nosniff
