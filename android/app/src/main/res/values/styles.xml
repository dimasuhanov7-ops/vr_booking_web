<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тема окна на время старта процесса. Тёмная в обоих вариантах: у
         приложения одна тема, и подстраиваться под системный светлый режим
         значило бы мигать белым перед тёмным интерфейсом. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Тема окна после старта — фон за интерфейсом Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/ic_launcher_background</item>
    </style>
</resources>
